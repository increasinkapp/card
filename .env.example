# Salin nilai-nilai ini ke Vercel > Project > Settings > Environment Variables.
# Jangan pernah commit file .env yang sudah terisi.

# Password yang diminta setelah tiga ketukan di pojok kanan atas.
EDITOR_PASSWORD=

# Kunci acak untuk menandatangani tiket sesi. Bikin dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Fine-grained personal access token, akses hanya ke repo ini,
# permission Contents: Read and write. Tidak perlu yang lain.
GITHUB_TOKEN=

# Format "owner/nama-repo", contoh increasinkapp/card
GITHUB_REPO=increasinkapp/card

# Opsional, default main
GITHUB_BRANCH=main

# Terisi otomatis setelah Blob store (Public) di-Connect ke project di dashboard Vercel.
# Dipakai /api/upload untuk menyimpan gambar dari editor.
BLOB_READ_WRITE_TOKEN=

# Opsional. Asal gambar tambahan yang diterima /api/publish, dipisah koma.
# Hanya untuk dev server lokal, kosongkan di produksi.
MEDIA_ORIGINS=
